{
  "name": "gpc-shi",
  "version": "2.0.0",
  "productName": "GPC SHI 2.0",
  "description": "GPC SHI 2.0",
  "main": "main.js",
  "author": "GPC STUDIO",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"GPC SHI 2.0\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=icon.ico --ignore=^/dist",
    "installer": "electron-builder --win nsis --publish never",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "@electron/packager": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "studio.gpc.shi",
    "productName": "GPC SHI 2.0",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "index.html",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "GPC-SHI-2.0-Setup.${ext}"
    },
    "portable": {
      "artifactName": "GPC-SHI-2.0-Portable.${ext}"
    }
  }
}